    <FileTemplate>{ &lt;series&gt;}{  #&lt;number0&gt;}{  - &lt;title&gt;}{  Vol.&lt;volume0&gt;}</FileTemplate>
    <EmptyFolder />
    <EmptyData />
    <Postfix>
      <Item Name="Format" Value=")" />
      <Item Name="Month" Value=", " />
      <Item Name="Month Number" Value=", " />
      <Item Name="Count" Value=")" />
      <Item Name="Year" Value=")" />
    </Postfix>
    <Prefix>
      <Item Name="Start Year" Value="(" />
      <Item Name="Volume" Value="Vol." />
      <Item Name="Month" Value="(" />
      <Item Name="Number" Value="#" />
      <Item Name="Month Number" Value="(" />
      <Item Name="Count" Value="(of " />
    </Prefix>
    <Seperator>
      <Item Name="Scan Information" Value="," />
      <Item Name="Locations" Value="," />
      <Item Name="Characters" Value=", " />
      <Item Name="Colorist" Value="," />
      <Item Name="Tags" Value=", " />
      <Item Name="Inker" Value="," />
      <Item Name="Letterer" Value="," />
      <Item Name="Genre" Value=", " />
      <Item Name="Alternate Series Multi" Value="," />
      <Item Name="Editor" Value="," />
      <Item Name="Teams" Value=", " />
      <Item Name="Cover Artist" Value="," />
      <Item Name="Penciller" Value="," />
      <Item Name="Writer" Value=", " />
    </Seperator>
    <IllegalCharacters>
      <Item Name="&quot;" Value="'" />
      <Item Name="/" Value="" />
      <Item Name="*" Value="" />
      <Item Name="&lt;" Value="[" />
      <Item Name="?" Value="" />
      <Item Name="&gt;" Value="]" />
      <Item Name="|" Value="!" />
      <Item Name=":" Value=" - " />
      <Item Name="\" Value="" />
    </IllegalCharacters>
    <Months>
