    <TextBox>
      <Item Name="Read Percentage" Value="Read" />
      <Item Name="Manga" Value="Manga" />
      <Item Name="Series Complete" Value="Test En cours" />
    </TextBox>
    <UseFolder>true</UseFolder>
    <UseFileName>true</UseFileName>
    <ExcludeFolders />
