# Python « embeddable » livré dans le zip Windows (dossier python\ à côté de ComicRust.exe).
# Lu par scripts/python_embarque.ps1 (workflows CI et Release). Lignes NOM=valeur.
#
# Source : https://www.python.org/downloads/release/python-31317/ (21 octobre 2026),
# fichier « Windows embeddable package (64-bit) ». 3.13 est passée en mode « sécurité
# seulement » : les versions suivantes de la série ne fournissent plus forcément de
# paquets Windows. Pour changer de version : reprendre l'empreinte SHA-256 publiée sur la
# page de la version (python.org) ; le workflow refuse un fichier d'empreinte différente.
PYTHON_VERSION=3.13.17
PYTHON_EMBED_SHA256=9e35319bffedab8b36ad44d8f377cb4f1733bcec257a0b6d04d94f01486ddb38
